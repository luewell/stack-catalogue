{
  "defaults": {
    "type": "mailpit",
    "category": "mail",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "mailpit",
        "LICENSE"
      ],
      "strip": 0
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/axllent/mailpit/releases/download/v{version}/mailpit-darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/axllent/mailpit/releases/download/v{version}/mailpit-linux-amd64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/axllent/mailpit/releases/download/v{version}/mailpit-linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/axllent/mailpit/releases/download/v{version}/mailpit-windows-amd64.zip",
        "archive": "zip",
        "paths": [
          "mailpit.exe",
          "LICENSE"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/axllent/mailpit/releases/download/v{version}/mailpit-windows-arm64.zip",
        "archive": "zip",
        "paths": [
          "mailpit.exe",
          "LICENSE"
        ]
      }
    },
    "runtime": {
      "start": "exec \"$STACK_INSTALL_DIR/mailpit\" --smtp \"127.0.0.1:$STACK_PORT\" --listen \"127.0.0.1:${STACK_PORT_HTTP:?this Mailpit entry needs a newer Stack}\" --allowed-hosts \"${STACK_HOSTNAMES:?this Mailpit entry needs a newer Stack}\" --database \"$STACK_DATA_DIR/mailpit.db\" --smtp-auth-accept-any --smtp-auth-allow-insecure --smtp-disable-rdns --disable-version-check\n",
      "stop_signal": "SIGTERM",
      "default_port": 1025,
      "ports": [
        "http"
      ],
      "hostname": {
        "label": "mail",
        "port": "http"
      },
      "connection": {
        "SMTP_HOST": "127.0.0.1",
        "SMTP_PORT": "{port}",
        "MAIL_URL": "smtp://127.0.0.1:{port}"
      },
      "laravel_connection": {
        "MAIL_MAILER": "smtp",
        "MAIL_SCHEME": "smtp",
        "MAIL_HOST": "127.0.0.1",
        "MAIL_PORT": "{port}"
      },
      "bin_dir": ".",
      "windows": {
        "start": {
          "arguments": [
            "${STACK_INSTALL_DIR}/mailpit.exe",
            "--smtp",
            "127.0.0.1:${STACK_PORT}",
            "--listen",
            "127.0.0.1:${STACK_PORT_HTTP}",
            "--allowed-hosts",
            "${STACK_HOSTNAMES}",
            "--database",
            "${STACK_DATA_DIR}/mailpit.db",
            "--smtp-auth-accept-any",
            "--smtp-auth-allow-insecure",
            "--smtp-disable-rdns",
            "--disable-version-check"
          ]
        }
      }
    }
  },
  "services": [
    {
      "support": "current",
      "version": "1.31.6",
      "description": "Mailpit 1.31, a mail catcher with a web interface",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "1411270aa8fd7f4fb0cc358318754d7bb7c2c30bfd70572dd12d05a53e956373"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "10fa12ccc610f653d4ed4df848c1817f9935dcf4e9a6a458a19ab0fa02093f91"
          }
        },
        "linux/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "de07955b783236d9129da76da9a5970f1777834a18b2c07611de957be784dafe"
          }
        },
        "windows/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "5d5ad094bfb3bac9004f9d1105d2335fea9f8952c09951df73ae0a280e34d3b1"
          }
        },
        "windows/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "c04c77ac9fd9da27c91259d0484b93b163e8534964682f543204cf3301a6b967"
          }
        }
      }
    }
  ]
}
