{
  "services": [
    {
      "type": "s3",
      "category": "storage",
      "support": "current",
      "version": "1.7.0",
      "description": "versitygw, an S3 gateway over a plain directory",
      "artifacts": {
        "darwin/arm64": {
          "url": "https://github.com/versity/versitygw/releases/download/v1.7.0/versitygw_v1.7.0_Darwin_arm64.tar.gz",
          "digest": {
            "algorithm": "sha256",
            "value": "df3870bf83a88e0828864f2d9ab62d83a6e56722d620e84204bb04d48b9fe727"
          },
          "archive": "tar.gz",
          "paths": [
            "versitygw"
          ],
          "strip": 1
        },
        "linux/amd64": {
          "url": "https://github.com/versity/versitygw/releases/download/v1.7.0/versitygw_v1.7.0_Linux_x86_64.tar.gz",
          "digest": {
            "algorithm": "sha256",
            "value": "dacec530fecaa8776feec0536998dd4bd78036e0d4db0da9b9189d96bb790e03"
          },
          "archive": "tar.gz",
          "paths": [
            "versitygw"
          ],
          "strip": 1
        },
        "linux/arm64": {
          "url": "https://github.com/versity/versitygw/releases/download/v1.7.0/versitygw_v1.7.0_Linux_arm64.tar.gz",
          "digest": {
            "algorithm": "sha256",
            "value": "5ef8d098e58b66171f2d8cd93dfcf44a7b3984d2e5710562ab1af6c884bc0a34"
          },
          "archive": "tar.gz",
          "paths": [
            "versitygw"
          ],
          "strip": 1
        }
      },
      "runtime": {
        "initialise": "mkdir -p \"$STACK_DATA_DIR/buckets\" \"$STACK_DATA_DIR/iam\"",
        "initialised_marker": "buckets",
        "start": "\"$STACK_INSTALL_DIR/versitygw\" --port \"127.0.0.1:$STACK_PORT\" --iam-dir \"$STACK_DATA_DIR/iam\" posix \"$STACK_DATA_DIR/buckets\"",
        "stop_signal": "SIGTERM",
        "default_port": 7070,
        "connection": {
          "AWS_ENDPOINT_URL": "https://s3.{group}.{tld}",
          "AWS_REGION": "us-east-1",
          "AWS_S3_FORCE_PATH_STYLE": "true"
        },
        "ready": "ADMIN_ACCESS_KEY_ID=\"$ROOT_ACCESS_KEY\" ADMIN_SECRET_ACCESS_KEY=\"$ROOT_SECRET_KEY\" ADMIN_ENDPOINT_URL=\"http://127.0.0.1:$STACK_PORT\" \"$STACK_INSTALL_DIR/versitygw\" admin list-buckets",
        "secrets": [
          "ROOT_ACCESS_KEY",
          "ROOT_SECRET_KEY"
        ],
        "group_secrets": [
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY"
        ],
        "provision": "set -ef\nexport ADMIN_ACCESS_KEY_ID=\"$ROOT_ACCESS_KEY\"\nexport ADMIN_SECRET_ACCESS_KEY=\"$ROOT_SECRET_KEY\"\nexport ADMIN_ENDPOINT_URL=\"http://127.0.0.1:$STACK_PORT\"\n\nadmin() {\n  \"$STACK_INSTALL_DIR/versitygw\" admin \"$@\"\n}\n\nfor bucket in $STACK_BUCKETS; do\n  admin list-buckets | awk '{print $1}' | grep -qx \"$bucket\" ||\n    admin create-bucket --bucket \"$bucket\" --owner \"$AWS_ACCESS_KEY_ID\"\ndone",
        "published": {
          "root": "buckets",
          "attribute": "user.policy",
          "ownership_attribute": "user.acl",
          "owner": "AWS_ACCESS_KEY_ID"
        },
        "provisioner": "versitygw"
      }
    }
  ]
}
