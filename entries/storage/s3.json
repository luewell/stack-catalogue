{
  "defaults": {
    "type": "s3",
    "category": "storage",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "versitygw"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/versity/versitygw/releases/download/v{version}/versitygw_v{version}_Darwin_arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/versity/versitygw/releases/download/v{version}/versitygw_v{version}_Linux_x86_64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/versity/versitygw/releases/download/v{version}/versitygw_v{version}_Linux_arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/versity/versitygw/releases/download/v{version}/versitygw_v{version}_Windows_x86_64.zip",
        "archive": "zip",
        "paths": [
          "versitygw.exe"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/versity/versitygw/releases/download/v{version}/versitygw_v{version}_Windows_arm64.zip",
        "archive": "zip",
        "paths": [
          "versitygw.exe"
        ]
      }
    },
    "runtime": {
      "initialise": "mkdir -p \"$STACK_DATA_DIR/buckets\" \"$STACK_DATA_DIR/iam\"",
      "initialised_marker": "buckets",
      "start": "\"$STACK_INSTALL_DIR/versitygw\" --port \"127.0.0.1:$STACK_PORT\" --iam-dir \"$STACK_DATA_DIR/iam\" posix \"$STACK_DATA_DIR/buckets\"",
      "stop_signal": "SIGTERM",
      "default_port": 7070,
      "connection": {
        "AWS_ENDPOINT_URL": "https://s3.{group}.{tld}",
        "AWS_REGION": "us-east-1",
        "AWS_S3_FORCE_PATH_STYLE": "true",
        "S3_ENDPOINT": "https://s3.{group}.{tld}",
        "S3_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "S3_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}"
      },
      "ready": "ADMIN_ACCESS_KEY_ID=\"$ROOT_ACCESS_KEY\" ADMIN_SECRET_ACCESS_KEY=\"$ROOT_SECRET_KEY\" ADMIN_ENDPOINT_URL=\"http://127.0.0.1:$STACK_PORT\" \"$STACK_INSTALL_DIR/versitygw\" admin list-buckets",
      "secrets": [
        "ROOT_ACCESS_KEY",
        "ROOT_SECRET_KEY"
      ],
      "group_secrets": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "provision": "set -ef\nexport ADMIN_ACCESS_KEY_ID=\"$ROOT_ACCESS_KEY\"\nexport ADMIN_SECRET_ACCESS_KEY=\"$ROOT_SECRET_KEY\"\nexport ADMIN_ENDPOINT_URL=\"http://127.0.0.1:$STACK_PORT\"\n\nadmin() {\n  \"$STACK_INSTALL_DIR/versitygw\" admin \"$@\"\n}\n\nfor bucket in $STACK_BUCKETS; do\n  admin list-buckets | awk '{print $1}' | grep -qx \"$bucket\" ||\n    admin create-bucket --bucket \"$bucket\" --owner \"$AWS_ACCESS_KEY_ID\"\ndone",
      "published": {
        "root": "buckets",
        "attribute": "user.policy",
        "ownership_attribute": "user.acl",
        "owner": "AWS_ACCESS_KEY_ID"
      },
      "provisioner": "versitygw",
      "container_connection": {
        "AWS_ENDPOINT_URL": "https://s3.{group}.{tld}",
        "AWS_REGION": "us-east-1",
        "AWS_S3_FORCE_PATH_STYLE": "true",
        "S3_ENDPOINT": "https://s3.{group}.{tld}",
        "S3_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "S3_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}"
      },
      "shareable": true,
      "windows": {
        "initialise": "mkdir -p \"$STACK_DATA_DIR/buckets\" \"$STACK_DATA_DIR/iam\" \"$STACK_DATA_DIR/meta\"",
        "start": {
          "arguments": [
            "${STACK_INSTALL_DIR}/versitygw.exe",
            "--port",
            "127.0.0.1:${STACK_PORT}",
            "--iam-dir",
            "${STACK_DATA_DIR}/iam",
            "posix",
            "--sidecar",
            "${STACK_DATA_DIR}/meta",
            "${STACK_DATA_DIR}/buckets"
          ]
        },
        "sidecar": {
          "root": "meta",
          "attribute": "policy",
          "ownership_attribute": "acl"
        }
      }
    }
  },
  "services": [
    {
      "support": "current",
      "version": "1.7.0",
      "description": "versitygw, an S3 gateway over a plain directory",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "df3870bf83a88e0828864f2d9ab62d83a6e56722d620e84204bb04d48b9fe727"
          }
        },
        "linux/amd64": {
