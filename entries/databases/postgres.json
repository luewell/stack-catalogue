{
  "services": [
    {
      "type": "postgres",
      "category": "database",
      "support": "lts",
      "version": "18.6.0",
      "description": "PostgreSQL 18, supported until November 2030",
      "artifacts": {
        "darwin/arm64": {
          "url": "https://github.com/theseus-rs/postgresql-binaries/releases/download/18.6.0/postgresql-18.6.0-aarch64-apple-darwin.tar.gz",
          "digest": {
            "algorithm": "sha256",
            "value": "a257bcdb8aa3301a13d6a5bcec48f8c9517045b7cbae71e50788b2615539e95b"
          },
          "archive": "tar.gz",
          "paths": [
            "bin",
            "lib",
            "share"
          ],
          "strip": 1
        },
        "linux/amd64": {
          "url": "https://github.com/theseus-rs/postgresql-binaries/releases/download/18.6.0/postgresql-18.6.0-x86_64-unknown-linux-gnu.tar.gz",
          "digest": {
            "algorithm": "sha256",
            "value": "bb3d09f876b2383e25a8c9ce09e32d185a03656a23d074f5195542b1b1b3ca61"
          },
          "archive": "tar.gz",
          "paths": [
            "bin",
            "lib",
            "share"
          ],
          "strip": 1
        },
        "linux/arm64": {
          "url": "https://github.com/theseus-rs/postgresql-binaries/releases/download/18.6.0/postgresql-18.6.0-aarch64-unknown-linux-gnu.tar.gz",
          "digest": {
            "algorithm": "sha256",
            "value": "5d2b5e8be9e96bfc3d7f22090057a836ec36d5d092542d8d3b93cc145cf4ee13"
          },
          "archive": "tar.gz",
          "paths": [
            "bin",
            "lib",
            "share"
          ],
          "strip": 1
        }
      },
      "runtime": {
        "initialise": "{install}/bin/initdb --pgdata={data} --username={user} --auth=trust --encoding=UTF8 --no-sync",
        "initialised_marker": "PG_VERSION",
        "start": "{install}/bin/postgres -D {data} -p {port} -k {socket} -c listen_addresses=127.0.0.1",
        "stop_signal": "SIGINT",
        "default_port": 5432,
        "connection": {
          "DATABASE_URL": "postgres://{group}@127.0.0.1:{port}/{group}?sslmode=disable",
          "DB_URL": "postgres://{group}@127.0.0.1:{port}/{group}?sslmode=disable"
        },
        "provision": "set -e\n{install}/bin/psql -h {socket} -p {port} -U {user} -d postgres -q -v ON_ERROR_STOP=1 \u003c\u003c'SQL'\nSELECT 'CREATE ROLE \"{group}\" LOGIN'\n  WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{group}')\\gexec\nSELECT 'CREATE DATABASE \"{group}\" OWNER \"{group}\"'\n  WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{group}')\\gexec\nREVOKE CONNECT ON DATABASE \"{group}\" FROM PUBLIC;\nSQL\n"
      }
    },
