{
  "defaults": {
    "type": "mongodb",
    "category": "database",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://fastdl.mongodb.org/osx/mongodb-macos-arm64-{version}.tgz"
      },
      "linux/amd64": {
        "url": "https://fastdl.mongodb.org/linux/mongodb-linux-x86_64-ubuntu2404-{version}.tgz"
      },
      "linux/arm64": {
        "url": "https://fastdl.mongodb.org/linux/mongodb-linux-aarch64-ubuntu2404-{version}.tgz"
      }
    },
    "runtime": {
      "initialised_marker": "stack-administrator",
      "start": "\"$STACK_INSTALL_DIR/bin/mongod\" --dbpath \"$STACK_DATA_DIR/db\" --auth --bind_ip 127.0.0.1 --port \"$STACK_PORT\" --unixSocketPrefix \"$STACK_SOCKET_DIR\" --filePermissions 0700 --setParameter enableLocalhostAuthBypass=false",
      "stop_signal": "SIGTERM",
      "default_port": 27017,
      "connection": {
        "MONGODB_URI": "mongodb://{group}:${MONGODB_PASSWORD}@127.0.0.1:{port}/{group}?authSource={group}",
        "MONGODB_HOST": "127.0.0.1",
        "MONGODB_PORT": "{port}",
        "MONGODB_DATABASE": "{group}",
        "MONGODB_USERNAME": "{group}",
        "MONGODB_PASSWORD": "${MONGODB_PASSWORD}"
      },
      "bin_dir": "bin",
      "secrets": [
        "MONGODB_ADMIN_PASSWORD"
      ],
      "group_secrets": [
        "MONGODB_PASSWORD"
      ],
      "provisioner": "mongodb",
      "shareable": true
    }
  },
  "services": [
    {
      "support": "lts",
      "version": "8.0.32",
      "description": "MongoDB 8.0, the long-term release",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "f81cb258434d548dca7244d599c82eb339043d8dedd0b1b807870c9d263117f2"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "b411be17c31ef249767ed91974d876e007c91afd5f45e1534057d247eada9f0d"
          }
        },
        "linux/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "8cca3993520a7f189790264ee57fb5d55a91094fb4be5f06bbbaf67c974d273f"
          }
        }
      }
    },
    {
      "support": "current",
      "version": "8.3.11",
      "description": "MongoDB 8.3, the newest release",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "b586c3972880fcdea90690a6d22c22cd260b0972de717ca710c0bc77c64b039e"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "a8aa4f75dc0f2a66ab421529bb1452485222c6c98909b047a98d90981c34eabe"
          }
        },
        "linux/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "52540bfb1de7ad415524c6a5117d434fcd84f24f23e3db56e71977e9fed28f2e"
          }
        }
      }
    }
  ]
}
