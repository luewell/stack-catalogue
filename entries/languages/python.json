{
  "defaults": {
    "type": "python",
    "kind": "runtime",
    "category": "language",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin",
        "lib",
        "include"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260825/cpython-{version}+20260825-aarch64-apple-darwin-install_only.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260825/cpython-{version}+20260825-x86_64-unknown-linux-gnu-install_only.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260825/cpython-{version}+20260825-aarch64-unknown-linux-gnu-install_only.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260825/cpython-{version}+20260825-x86_64-pc-windows-msvc-install_only.tar.gz",
        "paths": [
          "python.exe",
          "pythonw.exe",
          "python3.dll",
          "python314.dll",
          "vcruntime140.dll",
          "vcruntime140_1.dll",
          "DLLs",
          "Lib",
          "Scripts",
          "include",
          "libs",
          "LICENSE.txt"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260825/cpython-{version}+20260825-aarch64-pc-windows-msvc-install_only.tar.gz",
        "paths": [
          "python.exe",
          "pythonw.exe",
          "python3.dll",
          "python314.dll",
          "vcruntime140.dll",
          "vcruntime140_1.dll",
          "DLLs",
          "Lib",
          "Scripts",
          "include",
          "libs",
          "LICENSE.txt"
        ]
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "python",
        "python3",
        "pip",
        "pip3"
      ],
      "exposed": [
        "python3"
      ],
      "windows": {
        "bin_dir": ".",
        "exposed": [
          "python"
        ]
      }
    }
  },
