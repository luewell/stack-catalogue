{
  "defaults": {
    "type": "rust",
    "kind": "runtime",
    "category": "language",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin",
        "lib"
      ],
      "strip": 2
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://static.rust-lang.org/dist/rust-{version}-aarch64-apple-darwin.tar.gz"
      },
      "linux/amd64": {
        "url": "https://static.rust-lang.org/dist/rust-{version}-x86_64-unknown-linux-gnu.tar.gz"
      },
      "linux/arm64": {
        "url": "https://static.rust-lang.org/dist/rust-{version}-aarch64-unknown-linux-gnu.tar.gz"
      },
      "windows/amd64": {
        "url": "https://static.rust-lang.org/dist/rust-{version}-x86_64-pc-windows-msvc.tar.gz"
      },
      "windows/arm64": {
        "url": "https://static.rust-lang.org/dist/rust-{version}-aarch64-pc-windows-msvc.tar.gz"
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "cargo",
        "rustc",
        "rustdoc",
        "rustfmt",
        "cargo-fmt",
        "cargo-clippy",
        "clippy-driver",
        "rust-analyzer",
        "rust-gdb",
        "rust-gdbgui",
        "rust-lldb"
      ],
      "exposed": [
        "cargo",
        "rustc",
        "rustdoc",
        "rustfmt",
        "cargo-fmt",
        "cargo-clippy",
        "clippy-driver"
      ]
    }
  },
  "services": [
    {
      "support": "current",
      "version": "1.98.1",
      "description": "Rust 1.98, the current stable release",
      "artifacts": {
        "darwin/arm64": {
