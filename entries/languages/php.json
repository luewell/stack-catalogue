        "url": "https://github.com/luewell/stack-binaries/releases/download/php-{version}/php-{version}-linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/php-{version}-windows/php-{version}-windows-x86_64.zip",
        "archive": "zip",
        "paths": [
          "bin",
          "NOTICE-libraries.txt"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/php-{version}-windows/php-{version}-windows-x86_64.zip",
        "archive": "zip",
        "paths": [
          "bin",
          "NOTICE-libraries.txt"
        ]
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "php"
      ],
      "bin_dir": "bin"
    }
