{
  "defaults": {
    "type": "node",
    "kind": "runtime",
    "category": "language",
    "summary": "Node.js, the JavaScript runtime, with npm and npx.",
    "resolver": "nodejs.org",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin",
        "lib",
        "include"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-linux-x64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-win-x64.zip",
        "archive": "zip",
        "paths": [
          "node.exe",
          "npm",
          "npm.cmd",
          "npx",
          "npx.cmd",
          "corepack",
          "corepack.cmd",
          "node_modules",
          "LICENSE"
        ]
      },
      "windows/arm64": {
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-win-arm64.zip",
        "archive": "zip",
        "paths": [
          "node.exe",
          "npm",
          "npm.cmd",
          "npx",
          "npx.cmd",
          "corepack",
          "corepack.cmd",
          "node_modules",
          "LICENSE"
        ]
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "node",
        "npm",
        "npx"
      ],
      "exposed": [
        "node"
      ],
      "trust": {
        "bundle": "add",
        "variable": "NODE_EXTRA_CA_CERTS",
        "serves": [
          "vite",
          "nuxt",
          "next"
        ]
      },
      "container": {
        "site_check": [
          "-e",
          "require('http').get('http://127.0.0.1:{port}',()=>process.exit(0)).on('error',()=>process.exit(1))"
        ]
      },
      "windows": {
        "bin_dir": "."
      }
    },
    "recipes": [
      {
        "title": "Vite front end, npm in the shell",
        "yaml": "group: shop\nruntimes:\n  node: {version: \"26\", commands: [npm, npx]}\nsites:\n  - {name: web, type: vite}\n",
        "gives": "Gives https://web.shop.test running vite, and node, npm and npx in the shell."
      },
      {
        "title": "One Node.js for every repository in a group",
        "yaml": "group: shop\ndefaults:\n  runtimes:\n    node: \"26\"\n",
        "gives": "Gives node 26 to every repository of group shop that pins no node of its own."
      }
    ]
  },
  "services": [
    {
      "support": "lts",
      "version": "26.13.1",
      "description": "Node.js 26, the newest long-term support release",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "aec2514ea1ceb2ba52455e9ec65986f6749a06dd759e5db2a72e6889668c9735"
          }
        },
        "linux/amd64": {
