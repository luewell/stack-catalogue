{
  "defaults": {
    "type": "ruby",
    "kind": "runtime",
    "category": "language",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin",
        "include",
        "lib",
        "libexec"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.macos.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.x86_64_linux.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.arm64_linux.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/ruby-{version}-windows/ruby-{version}-windows-x86_64.zip",
        "archive": "zip",
        "paths": [
          "bin",
          "include",
          "lib",
          "LICENSE.txt"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/ruby-{version}-windows/ruby-{version}-windows-arm64.zip",
        "archive": "zip",
        "paths": [
          "bin",
          "include",
          "lib",
          "LICENSE.txt"
        ]
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "ruby",
        "gem",
        "bundle",
        "bundler",
        "rake",
        "irb",
        "erb"
      ],
      "exposed": [
        "ruby"
      ]
    }
  },
