{
  "defaults": {
    "type": "ruby",
    "kind": "runtime",
    "category": "language",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin",
        "include",
        "lib",
        "libexec"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.macos.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.x86_64_linux.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.arm64_linux.tar.gz"
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "ruby",
        "gem",
        "bundle",
        "bundler",
        "rake",
        "irb",
        "erb"
      ]
    }
  },
  "services": [
    {
      "support": "current",
      "version": "3.3.12",
      "description": "Ruby 3.3, security fixes only, and they end 31 March 2027",
      "artifacts": {
