{
  "defaults": {
    "type": "go",
    "kind": "runtime",
    "category": "language",
    "summary": "The Go toolchain, with go and gofmt.",
    "resolver": "go.dev",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin",
        "src",
        "pkg",
        "lib",
        "misc",
        "api",
        "go.env",
        "VERSION",
        "LICENSE"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://go.dev/dl/go{version}.darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://go.dev/dl/go{version}.linux-amd64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://go.dev/dl/go{version}.linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://go.dev/dl/go{version}.windows-amd64.zip",
        "archive": "zip"
      },
      "windows/arm64": {
        "url": "https://go.dev/dl/go{version}.windows-arm64.zip",
        "archive": "zip"
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "go",
        "gofmt"
      ],
      "exposed": [
        "go"
      ],
      "version_arguments": [
        "version"
      ],
      "container": {
        "environment": {
          "GOPATH": "/home/stack/go",
          "GOTOOLCHAIN": "local"
        },
        "path": [
          "/home/stack/go/bin"
        ],
        "version_output": {
          "name": "Go",
          "prefix": "go version go{release} "
        },
        "base_priority": -1
      }
    },
    "recipes": [
      {
        "title": "Go with gofmt in the shell",
        "yaml": "group: shop\nruntimes:\n  go: {version: \"1.27\", commands: [gofmt]}\n",
        "gives": "Gives go and gofmt in the shell."
      }
    ]
  },
  "services": [
    {
      "support": "current",
      "version": "1.27.1",
      "description": "Go 1.27, the current release",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "ee215d57e0ec269c60cc9ceca68e6bda321ba9ee5afe24f4b0988703c2d87d12"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445"
          }
        },
        "linux/arm64": {
          "digest": {
