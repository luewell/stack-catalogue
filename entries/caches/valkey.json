{
  "defaults": {
    "type": "valkey",
    "category": "cache",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/valkey-{version}/valkey-{version}-macos-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://download.valkey.io/releases/valkey-{version}-noble-x86_64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://download.valkey.io/releases/valkey-{version}-noble-arm64.tar.gz"
      }
    },
    "runtime": {
      "start": "umask 077\nacl=\"$STACK_DATA_DIR/users.acl\"\nif [ ! -e \"$acl\" ]; then\n  printf 'user default on >%s ~* &* +@all\\n' \"$VALKEY_ADMIN_PASSWORD\" > \"$acl\"\nfi\nexec \"$STACK_INSTALL_DIR/bin/valkey-server\" --port \"$STACK_PORT\" --bind 127.0.0.1 --dir \"$STACK_DATA_DIR\" --unixsocket \"$STACK_SOCKET_DIR/valkey.sock\" --appendonly no --aclfile \"$acl\"\n",
      "stop_signal": "SIGTERM",
      "default_port": 6379,
      "connection": {
        "REDIS_URL": "redis://{group}:${REDIS_PASSWORD}@127.0.0.1:{port}",
        "REDIS_HOST": "127.0.0.1",
        "REDIS_PORT": "{port}",
        "REDIS_USERNAME": "{group}"
      },
      "bin_dir": "bin",
      "commands": [
        "valkey-cli"
      ],
      "ready": "VALKEYCLI_AUTH=\"$VALKEY_ADMIN_PASSWORD\" \"$STACK_INSTALL_DIR/bin/valkey-cli\" -s \"$STACK_SOCKET_DIR/valkey.sock\" --no-auth-warning ping | grep -qx PONG",
      "secrets": [
        "VALKEY_ADMIN_PASSWORD"
      ],
      "group_secrets": [
        "REDIS_PASSWORD"
      ],
      "provision": "set -eu\nresult=\"$(printf 'ACL SETUSER %s reset on >%s ~* &* +@all -@admin\\nACL SAVE\\n' \"$STACK_GROUP\" \"$REDIS_PASSWORD\" | VALKEYCLI_AUTH=\"$VALKEY_ADMIN_PASSWORD\" \"$STACK_INSTALL_DIR/bin/valkey-cli\" -s \"$STACK_SOCKET_DIR/valkey.sock\" --no-auth-warning 2>&1)\"\nif [ \"$result\" != \"$(printf 'OK\\nOK')\" ]; then\n  printf 'Valkey refused the group account: %s\\n' \"$result\" >&2\n  exit 1\nfi\n"
    }
  },
  "services": [
    {
      "support": "current",
      "version": "9.1.1",
      "description": "Valkey, the BSD-licensed Redis fork",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "5b5648f25e365ff758346815fb7da46d8270f2832d3d4e9fd1901b1d0177e34b"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "41f5eb5dc88111c5d117821c120c5a9fbcf2bcc3316953f811c04444046ecb28"
          }
        },
        "linux/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "f1477b12c36832dcb8e3e2f83c1a1554a18ab94b204d017e1d8443bff1dade21"
          }
        }
      }
    }
  ]
}
