{
  "defaults": {
    "type": "valkey",
    "category": "cache",
    "aliases": [
      "redis"
    ],
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "bin"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/valkey-{version}/valkey-{version}-macos-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://download.valkey.io/releases/valkey-{version}-noble-x86_64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://download.valkey.io/releases/valkey-{version}-noble-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/valkey-{version}-windows/valkey-{version}-windows-x86_64.zip",
        "archive": "zip"
      },
      "windows/arm64": {
        "url": "https://github.com/luewell/stack-binaries/releases/download/valkey-{version}-windows/valkey-{version}-windows-x86_64.zip",
        "archive": "zip"
      }
    },
    "runtime": {
      "start": "umask 077\nacl=\"$STACK_DATA_DIR/users.acl\"\nif [ ! -e \"$acl\" ]; then\n  printf 'user default on >%s ~* &* +@all\\n' \"$VALKEY_ADMIN_PASSWORD\" > \"$acl\"\nfi\nexec \"$STACK_INSTALL_DIR/bin/valkey-server\" \"$@\" --port \"$STACK_PORT\" --bind 127.0.0.1 --dir \"$STACK_DATA_DIR\" --unixsocket \"$STACK_SOCKET_DIR/valkey.sock\" --appendonly no --aclfile \"$acl\"\n",
      "initialised_marker": "users.acl",
      "extend": {
        "mechanism": "include",
        "syntax": "valkey",
        "suffix": ".conf",
        "file": "valkey.conf",
        "arguments": [
          "${STACK_CONFIG_FILE}"
        ],
        "reserved": [
          {
            "key": "loadmodule",
            "reason": "loads code into the server"
          },
          {
            "key": "enable-module-command",
            "reason": "would let clients load code into the server"
          },
          {
            "key": "enable-debug-command",
            "reason": "would let clients run debugging commands"
          },
          {
            "key": "enable-protected-configs",
            "reason": "would let clients change protected settings such as dir"
          },
          {
            "key": "user",
            "reason": "defines accounts beside Stack's ACL file, which Valkey refuses"
          },
          {
            "key": "aclfile",
            "reason": "holds the accounts Stack manages"
          },
          {
            "key": "requirepass",
            "reason": "changes the password of Stack's administrator"
          },
          {
            "key": "primaryauth",
            "reason": "signs in to another server as a replica"
          },
          {
            "key": "masterauth",
            "reason": "signs in to another server as a replica"
          },
          {
            "key": "primaryuser",
            "reason": "signs in to another server as a replica"
          },
          {
            "key": "masteruser",
            "reason": "signs in to another server as a replica"
          },
          {
            "key": "replicaof",
            "reason": "turns the server into a replica of another"
          },
          {
            "key": "slaveof",
            "reason": "turns the server into a replica of another"
          },
          {
            "key": "rename-command",
            "reason": "would hide commands Stack provisions and stops the server with"
          },
          {
            "key": "sentinel",
            "reason": "runs a different server mode"
          },
          {
            "key": "dir",
            "reason": "is the data directory Stack manages, which Stack sets on the command line"
          },
          {
            "key": "port",
            "reason": "is where Stack's clients connect, which Stack sets on the command line"
          },
          {
            "key": "bind",
            "reason": "is where Stack's clients connect, which Stack sets on the command line"
          },
          {
            "key": "unixsocket",
            "reason": "is the private socket Stack connects through, which Stack sets on the command line"
          },
          {
            "key": "unixsocketperm",
            "reason": "decides who may reach the server's private socket"
          },
          {
            "key": "unixsocketgroup",
            "reason": "decides who may reach the server's private socket"
          },
          {
            "key": "protected-mode",
            "reason": "guards the server against connections Stack did not set up"
          },
          {
            "key": "tls-port",
            "reason": "listens where Stack did not ask"
          },
          {
            "key": "rdma-port",
            "reason": "listens where Stack did not ask"
          },
          {
            "key": "rdma-bind",
            "reason": "listens where Stack did not ask"
          },
          {
            "key": "cluster-enabled",
            "reason": "opens a cluster bus port Stack did not ask for"
          },
          {
            "key": "cluster-port",
            "reason": "listens where Stack did not ask"
          },
          {
            "key": "daemonize",
            "reason": "detaches the server from the process Stack supervises"
          },
          {
            "key": "appendonly",
            "reason": "is set by Stack on the command line"
          },
          {
            "key": "pidfile",
            "reason": "writes files Stack does not manage"
          },
          {
            "key": "logfile",
            "reason": "writes files Stack does not manage"
          },
          {
            "key": "syslog-enabled",
            "reason": "writes files Stack does not manage"
          },
          {
            "key": "syslog-ident",
            "reason": "writes files Stack does not manage"
          },
          {
            "key": "syslog-facility",
            "reason": "writes files Stack does not manage"
          },
          {
            "key": "cluster-config-file",
            "reason": "writes files Stack does not manage"
          },
          {
            "key": "dbfilename",
            "reason": "names a file in the data directory, where Stack keeps its ACL file"
          }
        ]
      },
      "stop_signal": "SIGTERM",
      "default_port": 6379,
      "connection": {
        "REDIS_URL": "redis://{group}:${REDIS_PASSWORD}@127.0.0.1:{port}",
        "REDIS_HOST": "127.0.0.1",
        "REDIS_PORT": "{port}",
        "REDIS_USERNAME": "{group}"
      },
      "bin_dir": "bin",
      "commands": [
        "valkey-cli"
      ],
      "ready": "VALKEYCLI_AUTH=\"$VALKEY_ADMIN_PASSWORD\" \"$STACK_INSTALL_DIR/bin/valkey-cli\" -s \"$STACK_SOCKET_DIR/valkey.sock\" --no-auth-warning ping | grep -qx PONG",
      "secrets": [
        "VALKEY_ADMIN_PASSWORD"
      ],
      "group_secrets": [
        "REDIS_PASSWORD"
      ],
      "provision": "set -eu\nresult=\"$(printf 'ACL SETUSER %s reset on >%s ~* &* +@all -@admin\\nACL SAVE\\n' \"$STACK_GROUP\" \"$REDIS_PASSWORD\" | VALKEYCLI_AUTH=\"$VALKEY_ADMIN_PASSWORD\" \"$STACK_INSTALL_DIR/bin/valkey-cli\" -s \"$STACK_SOCKET_DIR/valkey.sock\" --no-auth-warning 2>&1)\"\nif [ \"$result\" != \"$(printf 'OK\\nOK')\" ]; then\n  printf 'Valkey refused the group account: %s\\n' \"$result\" >&2\n  exit 1\nfi\n",
      "windows": {
        "initialise": "printf 'user default on >%s ~* &* +@all\\n' \"$VALKEY_ADMIN_PASSWORD\" > \"$STACK_DATA_DIR/users.acl\"\n",
        "start": {
          "arguments": [
            "${STACK_INSTALL_DIR}/bin/valkey-server.exe",
            "--port",
            "${STACK_PORT}",
            "--bind",
            "127.0.0.1",
            "--dir",
            "${STACK_DATA_DIR}",
            "--unixsocket",
            "${STACK_SOCKET_DIR}/valkey.sock",
            "--appendonly",
            "no",
            "--aclfile",
            "${STACK_DATA_DIR}/users.acl"
          ]
        },
        "stop_request": {
          "protocol": "resp",
          "secret": "VALKEY_ADMIN_PASSWORD"
        }
      }
    }
  },
  "services": [
    {
      "support": "current",
      "version": "9.1.1",
      "description": "Valkey, the BSD-licensed Redis fork",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "5b5648f25e365ff758346815fb7da46d8270f2832d3d4e9fd1901b1d0177e34b"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "41f5eb5dc88111c5d117821c120c5a9fbcf2bcc3316953f811c04444046ecb28"
          }
        },
        "linux/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "f1477b12c36832dcb8e3e2f83c1a1554a18ab94b204d017e1d8443bff1dade21"
          }
        },
        "windows/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "f6a476ebfc9a2c2fca7caf1c2c2342a9d9f87029ff6006451922a240aedcecf0"
          }
        },
        "windows/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "f6a476ebfc9a2c2fca7caf1c2c2342a9d9f87029ff6006451922a240aedcecf0"
          }
        }
      }
    }
  ]
}
