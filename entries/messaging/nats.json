{
  "defaults": {
    "type": "nats",
    "category": "messaging",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "nats-server",
        "LICENSE"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-linux-amd64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-windows-amd64.zip",
        "archive": "zip",
        "paths": [
          "nats-server.exe",
          "LICENSE"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-windows-arm64.zip",
        "archive": "zip",
        "paths": [
          "nats-server.exe",
          "LICENSE"
        ]
      }
    },
    "runtime": {
      "initialised_marker": "stack-accounts",
      "start": "umask 077\nprintf 'max_payload: 64MB\\ninclude ./accounts.conf\\n' > \"$STACK_DATA_DIR/nats.conf\"\nexec \"$STACK_INSTALL_DIR/nats-server\" -c \"$STACK_DATA_DIR/nats.conf\" -a 127.0.0.1 -p \"$STACK_PORT\" -js -sd \"$STACK_DATA_DIR/jetstream\"\n",
      "stop_signal": "SIGTERM",
      "default_port": 4222,
      "connection": {
        "NATS_URL": "nats://{group}:${NATS_PASSWORD}@127.0.0.1:{port}",
        "NATS_HOST": "127.0.0.1",
        "NATS_PORT": "{port}",
        "NATS_USER": "{group}",
        "NATS_PASSWORD": "${NATS_PASSWORD}"
      },
      "bin_dir": ".",
      "secrets": [
        "NATS_ADMIN_PASSWORD"
      ],
      "group_secrets": [
        "NATS_PASSWORD"
      ],
      "provisioner": "nats",
      "shareable": true,
      "windows": {
        "initialise": "printf 'max_payload: 64MB\\ninclude ./accounts.conf\\n' > \"$STACK_DATA_DIR/nats.conf\"\n",
        "start": {
          "arguments": [
            "${STACK_INSTALL_DIR}/nats-server.exe",
            "-c",
            "${STACK_DATA_DIR}/nats.conf",
            "-a",
            "127.0.0.1",
            "-p",
            "${STACK_PORT}",
            "-js",
            "-sd",
            "${STACK_DATA_DIR}/jetstream"
          ]
        }
      }
    }
  },
  "services": [
    {
      "support": "current",
      "version": "2.15.0",
      "description": "NATS 2.15, the newest release",
      "artifacts": {
        "darwin/arm64": {
