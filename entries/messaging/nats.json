{
  "defaults": {
    "type": "nats",
    "category": "messaging",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "nats-server",
        "LICENSE"
      ],
      "strip": 1
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-linux-amd64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/nats-io/nats-server/releases/download/v{version}/nats-server-v{version}-linux-arm64.tar.gz"
      }
    },
    "runtime": {
      "initialised_marker": "stack-accounts",
      "start": "umask 077\nprintf 'max_payload: 64MB\\ninclude ./accounts.conf\\n' > \"$STACK_DATA_DIR/nats.conf\"\nexec \"$STACK_INSTALL_DIR/nats-server\" -c \"$STACK_DATA_DIR/nats.conf\" -a 127.0.0.1 -p \"$STACK_PORT\" -js -sd \"$STACK_DATA_DIR/jetstream\"\n",
      "stop_signal": "SIGTERM",
      "default_port": 4222,
      "connection": {
        "NATS_URL": "nats://{group}:${NATS_PASSWORD}@127.0.0.1:{port}",
        "NATS_HOST": "127.0.0.1",
        "NATS_PORT": "{port}",
        "NATS_USER": "{group}",
        "NATS_PASSWORD": "${NATS_PASSWORD}"
      },
      "bin_dir": ".",
      "secrets": [
        "NATS_ADMIN_PASSWORD"
      ],
      "group_secrets": [
        "NATS_PASSWORD"
      ],
      "provisioner": "nats",
      "shareable": true
    }
  },
  "services": [
    {
      "support": "current",
      "version": "2.15.0",
      "description": "NATS 2.15, the newest release",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "e1c4e22d70bd44abfa0bcb3c16f7cf0c66f648c2e728c58924e8a1ce88913cc8"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "5d2c51caca950333aba84911df7d377f826f3a59ec36061c6539105084f65c92"
          }
        },
        "linux/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "cdc208f5a3f42963a52b6ab06ef65626bb870315dc936e26ba571780c6351112"
          }
        }
      }
    },
    {
      "support": "current",
      "version": "2.14.7",
      "description": "NATS 2.14, the previous release line",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "9fc225cddebc67438345ad988c5d6bfc6daad16a7609bcceaafa88bcab9b9001"
          }
        },
        "linux/amd64": {
          "digest": {
