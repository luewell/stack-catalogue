{
  "defaults": {
    "type": "pnpm",
    "kind": "runtime",
    "category": "packages",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "pnpm",
        "dist"
      ],
      "strip": 0
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-linux-x64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-win32-x64.zip",
        "archive": "zip",
        "paths": [
          "pnpm.exe",
          "dist"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-win32-arm64.zip",
        "archive": "zip",
        "paths": [
          "pnpm.exe",
          "dist"
        ]
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "pnpm"
      ],
      "bin_dir": "."
    }
  },
  "services": [
    {
      "support": "current",
      "version": "11.28.6",
      "description": "pnpm 11, the line pnpm points its own users at",
      "artifacts": {
