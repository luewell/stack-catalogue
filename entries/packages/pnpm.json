{
  "defaults": {
    "type": "pnpm",
    "kind": "runtime",
    "category": "packages",
    "summary": "pnpm, a Node.js package manager.",
    "resolver": "github.com/pnpm/pnpm",
    "every_platform": {
      "archive": "tar.gz",
      "paths": [
        "pnpm",
        "dist"
      ],
      "strip": 0
    },
    "artifacts": {
      "darwin/arm64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-darwin-arm64.tar.gz"
      },
      "linux/amd64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-linux-x64.tar.gz"
      },
      "linux/arm64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-linux-arm64.tar.gz"
      },
      "windows/amd64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-win32-x64.zip",
        "archive": "zip",
        "paths": [
          "pnpm.exe",
          "dist"
        ]
      },
      "windows/arm64": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v{version}/pnpm-win32-arm64.zip",
        "archive": "zip",
        "paths": [
          "pnpm.exe",
          "dist"
        ]
      }
    },
    "runtime": {
      "start": "",
      "commands": [
        "pnpm"
      ],
      "bin_dir": ".",
      "container": {}
    },
    "recipes": [
      {
        "title": "pnpm and Node.js for a Next.js app",
        "yaml": "group: shop\nruntimes:\n  node: \"24\"\n  pnpm: \"12\"\nsites:\n  - {name: app, type: next}\n",
        "gives": "Gives https://app.shop.test running next, with pnpm and node in the shell."
      }
    ]
  },
  "services": [
    {
      "support": "current",
      "version": "12.14.0",
      "description": "pnpm 12, the line pnpm points its own users at",
      "artifacts": {
        "darwin/arm64": {
          "digest": {
            "algorithm": "sha256",
            "value": "50f48e0e17508952790a3fbf58fcf14f3b82efa5f594ca04ad904e29aaf854b0"
          }
        },
        "linux/amd64": {
          "digest": {
            "algorithm": "sha256",
            "value": "3910c3852136bed5bc1511b9137a45fd4357ed6b3970d9d08893641e9005867e"
          }
        },
        "linux/arm64": {
